+// PiliPlus: a translucent sheet or dialog blurs what is behind it, like
+// glass; an opaque one is drawn as before
+Widget _piliGlass(Widget child, ShapeBorder? shape, Color? color, {bool extendDown = false}) {
+  if (color == null || color.a >= 1) {
+    return child;
+  }
+  final Widget glass = ClipPath(
+    clipper: ShapeBorderClipper(shape: shape ?? const RoundedRectangleBorder()),
+    child: BackdropFilter(
+      filter: ImageFilter.blur(sigmaX: 24, sigmaY: 24),
+      child: child,
+    ),
+  );
+  if (!extendDown) {
+    return glass;
+  }
+  // a springy sheet rises a little past its place; the glass goes on below
+  // its bottom edge so no gap opens under it
+  return Stack(
+    clipBehavior: Clip.none,
+    children: <Widget>[
+      glass,
+      Positioned(
+        left: 0,
+        right: 0,
+        bottom: -80,
+        height: 80,
+        child: ClipRect(
+          child: BackdropFilter(
+            filter: ImageFilter.blur(sigmaX: 24, sigmaY: 24),
+            child: ColoredBox(color: color),
+          ),
+        ),
+      ),
+    ],
+  );
+}
+
+/// PiliPlus: the app's motion for modal bottom sheets, e.g. a spring, used
+/// where a sheet does not bring an [AnimationStyle] of its own.
+abstract final class PiliSheetMotion {
+  static Curve? curve;
+  static Curve? reverseCurve;
+  static Duration? enterDuration;
+}
