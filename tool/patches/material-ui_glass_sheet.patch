+// PiliPlus: a translucent sheet or dialog blurs what is behind it, like
+// glass; an opaque one is drawn as before
+Widget _piliGlass(Widget child, ShapeBorder? shape, Color? color) {
+  if (color == null || color.a >= 1) {
+    return child;
+  }
+  return ClipPath(
+    clipper: ShapeBorderClipper(shape: shape ?? const RoundedRectangleBorder()),
+    child: BackdropFilter(
+      filter: ImageFilter.blur(sigmaX: 24, sigmaY: 24),
+      child: child,
+    ),
+  );
+}
